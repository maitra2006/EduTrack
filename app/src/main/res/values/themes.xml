<resources>
    <!-- Base Application Theme -->
    <style name="Theme.EduTrack" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Secondary / Accent Colors -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/primary</item>
        <item name="colorSecondaryContainer">@color/accent_light</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Theme with No Action Bar for Fullscreen / Custom Toolbars -->
    <style name="Theme.EduTrack.NoActionBar" parent="Theme.EduTrack">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
